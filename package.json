{
  "name": "seanad-chamber-vote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:votes": "node scripts/fetch_votes.mjs",
    "deploy": "gh-pages -d dist",
    "security:audit": "npm audit --audit-level=critical",
    "security:runtime": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run build && npm run security:runtime"
  },
  "dependencies": {
    "papaparse": "5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "gh-pages": "6.3.0",
    "vite": "8.2.2"
  }
}
